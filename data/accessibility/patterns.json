{
  "version": 1,
  "about": "Non-colour identity of each cassette: letter, shape and tiling pattern. Generated by art/accessibility/build_data.py from make_patterns.py.",
  "tile": {
    "size_px": 128,
    "repeats_per_tile": 4,
    "period_px": 32,
    "coverage": 0.4,
    "format": "8-bit greyscale coverage mask, white = pattern",
    "import": "repeat enabled, linear filter with mipmaps; tint in the shader / draw call",
    "strip": "res://assets/textures/patterns/pattern_strip_abcd.png",
    "strip_note": "512x128, A..D left to right: import as Texture2DArray with 4 horizontal slices to index by tape in one shader"
  },
  "use": {
    "min_period_on_screen_px": 8,
    "recommended_tile_on_screen_px": {
      "hud": 48,
      "world_per_metre": 128
    },
    "overlay": "draw in on_color (palette.json) at alpha 0.30 over a cassette fill, or in the cassette colour at alpha 0.85 over ink",
    "never": [
      "animate or scroll faster than 16 px/s",
      "cover more than 10 % of the screen",
      "use on text"
    ]
  },
  "carriers": {
    "about": "Where each identity channel appears. 'always' cannot be switched off; 'option' follows the patterns setting.",
    "outline": {
      "letter": "no",
      "shape": "no",
      "pattern": "no",
      "spec": "Ink hull in the cassette colour. The outline never carries identity alone: the ring and badge under the same figure do."
    },
    "floor_ring": {
      "letter": "always",
      "shape": "always",
      "pattern": "option",
      "spec": "Ring outline is the cassette shape (AccessKit.ring_mesh, circumradius 0.45 m, band 0.07 m) over an ink backing ring. Letter badge on the camera side, never below 0.6 opacity. With patterns on, the faint disc inside the ring is filled with the pattern at 2 tiles per metre, static in world space."
    },
    "spark": {
      "letter": "no",
      "shape": "always",
      "pattern": "no",
      "spec": "Core is the filled cassette shape (shape texture, 0.16 m across, billboarded) with a white centre and an ink keyline; comet trail is shrinking copies of the same shape. Too small for a pattern or a letter; the tether leads to the lettered ring."
    },
    "tether": {
      "letter": "no",
      "shape": "no",
      "pattern": "no",
      "spec": "Dashed line in the cassette colour with an ink under-stroke 2 px wider. Identity comes from the two things it joins."
    },
    "swing_trail": {
      "letter": "no",
      "shape": "no",
      "pattern": "option",
      "spec": "Ribbon in the cassette colour. With patterns on, the pattern tile runs along the ribbon (UV.x = length / 0.5 m) at 0.35 alpha in on_color; no scrolling."
    },
    "projectile": {
      "letter": "no",
      "shape": "always",
      "pattern": "no",
      "spec": "A self's projectile carries a small filled cassette shape at its head with an ink keyline; enemy projectiles never use the four shapes."
    },
    "enemy_target_pip": {
      "letter": "always",
      "shape": "always",
      "pattern": "no",
      "spec": "The pip an enemy shows for the self it targets is the cassette shape with the letter inside, not a coloured dot."
    },
    "hud_deck": {
      "letter": "always",
      "shape": "always",
      "pattern": "option",
      "spec": "Letter sticker (already there). Cassette shape as a small mark beside the speed readout. Pattern over the shell at 48 px per tile."
    },
    "hud_lane": {
      "letter": "always",
      "shape": "always",
      "pattern": "option",
      "spec": "Gutter chip with the letter; the lane's end cap is the cassette shape (filled when recorded, ring when not); pattern on every recorded pass."
    },
    "map_pip": {
      "letter": "when 14 px or larger",
      "shape": "always",
      "pattern": "no",
      "spec": "Cassette shape, filled, ink keyline. Below 14 px the letter is dropped and the shape alone names the tape."
    },
    "offscreen_marker": {
      "letter": "always",
      "shape": "always",
      "pattern": "no",
      "spec": "Edge-of-screen arrow ends in the cassette shape with the letter."
    },
    "menus": {
      "letter": "always",
      "shape": "always",
      "pattern": "option",
      "spec": "Cassette art uses the same four patterns as the HUD; tape strips on results / campaign rows show letter + shape."
    }
  },
