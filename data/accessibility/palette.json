  "keylines": {
    "why": "No bright colour reaches 3:1 against the upper and mid floors (see worst_floor_contrast), so a cassette mark in the world is never drawn bare.",
    "ink": "#14110f",
    "paper": "#f3ead8",
    "default": {
      "ink_px_at_1080p": 2.0,
      "paper_px_at_1080p": 0.0
    },
    "high_contrast": {
      "ink_px_at_1080p": 3.0,
      "paper_px_at_1080p": 2.0,
      "order_outward": [
        "colour",
        "paper",
        "ink"
      ]
    },
    "scale": "pixels scale with viewport height / 1080, never below 1.5 px"
  },
  "reserved": {
    "about": "Colours with a fixed non-cassette meaning. No cassette colour may sit within dE 10 of these.",
