  "ui_state_colors": {
    "about": "HUD state colours must not reuse a cassette colour (ui/theme/palette.gd currently does: THREAT and STATE_BAD equal legacy A, STATE_GOOD equals legacy D).",
    "danger": "#ff5a3c",
    "good": "#f3ead8",
    "warn": "#ffb347",
    "dead": "#9aa3b5",
    "desync": "#c98bff"
  },
  "rules": [
    "Cassette colour is never the only carrier of identity: the letter and the shape are always on; the pattern is an option.",
    "Saturated red belongs to danger (laser, enemy hit, closed door, REC lamp). Cassette A is rose, not red.",
    "Moxie gold (#ffd23f) stays on her headphones and Walkman and on brand UI. Cassette B is lemon, which is 11 dE away, and always carries its triangle and letter.",
    "Every cassette mark in the world has an ink keyline; in high-contrast mode a paper line sits between the colour and the ink.",
    "Text in a cassette colour on the HUD panel uses text_on_panel; text on a cassette fill uses on_color."
  ]
}