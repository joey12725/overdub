{
  "version": 1,
  "about": "Coach marks: contextual one-line teaching cues tied to real HUD elements and game moments. Specification: docs/ONBOARDING.md. Vocabulary: data/onboarding/vocabulary.json. File order is priority order (first eligible mark wins); 'urgent' marks are considered first.",

  "limits": {
    "maxVisible": 1,
    "minGapSeconds": 1.5,
    "maxPerPhaseVisit": 2,
    "maxUrgentPerPhaseVisit": 2,
    "defaultLingerSeconds": 10,
    "minShownSecondsToCount": 1.5
  },

  "marks": [
    {
      "id": "brief-objective",
      "teaches": "the objective chip is the job",
      "level": "01-soft-open",
      "phase": "briefing",
      "trigger": { "all": [ { "firstTimePhase": "briefing" }, { "phaseElapsed": { "min": 1.5 } } ] },
      "anchor": "objective",
      "text": "That's the job. {btn:start} when you've read it.",
      "dismissOn": { "sessionActionUsed": { "action": "start", "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "deck-armed",
      "teaches": "a deck is one take; record starts it",
      "level": "01-soft-open",
      "phase": "setup",
      "trigger": { "all": [ { "firstTimePhase": "setup" }, { "deckStatusIs": { "deck": "active", "status": "armed" } } ] },
      "anchor": "deck:active",
      "text": "This cassette is your take. {btn:record} rolls tape.",
      "dismissOn": { "sessionActionUsed": { "action": "record", "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "count-in",
      "teaches": "the count-in; every take starts on beat zero",
      "level": "any",
      "phase": "countin",
      "trigger": { "firstTimePhase": "countin" },
      "anchor": "countin",
      "text": "Five, six, seven, eight. You're on at beat zero.",
      "dismissOn": { "phaseIs": "recording" },
      "once": true
    },

    {
      "id": "death-ghost",
      "teaches": "dying does not end a take",
      "level": "any",
      "phase": "recording",
      "urgent": true,
      "trigger": { "liveSelfIs": "recGhost" },
      "anchor": "world:self",
      "text": "Dead, not done. Keep playing: this take carries on as a ghost.",
      "dismissOn": { "liveSelfTravelled": { "tiles": 2, "scope": "shown" } },
      "once": true
    },
    {
      "id": "clang",
      "teaches": "momentum: why the wall clanged",
      "level": "any",
      "phase": "recording",
      "urgent": true,
      "trigger": { "eventSeen": { "type": "clang", "tape": "live", "detailPrefix": "needs ", "scope": "phase" } },
      "anchor": "world:entity:subject",
      "text": "Clang. Not enough behind it. Take a run-up; momentum does the work.",
      "dismissOn": { "eventSeen": { "type": "break", "scope": "shown" } },
      "once": true
    },
    {
      "id": "desync",
      "teaches": "desync: the projection carries on, the self does not",
      "level": "any",
      "phase": "recording",
      "urgent": true,
      "trigger": { "eventSeen": { "type": "desync", "tape": "previous", "scope": "phase" } },
      "anchor": "world:self:subject",
      "text": "She's skipping. That outline is only the recording; it touches nothing.",
      "dismissOn": { "any": [ { "eventSeen": { "type": "resync", "scope": "shown" } }, { "shownFor": { "min": 6 } } ] },
      "once": true
    },
    {
      "id": "spark",
      "teaches": "the recovery spark",
      "level": "any",
      "phase": "recording",
      "urgent": true,
      "trigger": { "all": [ { "markDone": "desync" }, { "selfIs": { "who": "previous", "state": "desynced" } } ] },
      "anchor": "world:spark:subject",
      "text": "The spark is the real her, running to catch up. Clear the way.",
      "dismissOn": { "eventSeen": { "type": "resync", "scope": "shown" } },
      "once": true
    },
    {
      "id": "rescue",
      "teaches": "a later take can save an earlier one",
      "level": "any",
      "phase": "recording",
      "urgent": true,
      "trigger": { "selfFateChanged": { "who": "previous", "to": "alive" } },
      "anchor": "world:self:subject",
      "text": "She died right here last run. Not this time. Nice save.",
      "dismissOn": { "shownFor": { "min": 5 } },
      "once": true
    },
    {
      "id": "previous-died",
      "teaches": "old selves are fixed; the world is not",
      "level": "any",
      "phase": "recording",
      "urgent": true,
      "trigger": { "selfFateChanged": { "who": "previous", "to": "dead" } },
      "anchor": "world:self:subject",
      "text": "She lived through that last take. You changed the room on her.",
      "dismissOn": { "shownFor": { "min": 5 } },
      "once": true
    },
    {
      "id": "trap-warn",
      "teaches": "traps run on the beat and telegraph one beat ahead",
      "level": "any",
      "phase": "recording",
      "urgent": true,
      "trigger": { "eventSeen": { "type": "trap", "detailSuffix": ":warn", "scope": "phase" } },
      "anchor": "world:entity:subject",
      "text": "Traps keep time. That flash is your one beat of warning.",
      "dismissOn": { "eventSeen": { "type": "trap", "detailIn": ["spikes:up", "crusher:slam", "flame:on"], "scope": "shown" } },
      "once": true
    },

    {
      "id": "move",
      "teaches": "movement",
      "level": "01-soft-open",
      "phase": "recording",
      "trigger": { "inputNotUsedFor": { "input": "move", "seconds": 2 } },
      "skipIf": { "liveSelfTravelled": { "tiles": 3, "scope": "save" } },
      "anchor": "prompt:move",
      "text": "{btn:move} to move. The tape's already rolling.",
      "dismissOn": { "liveSelfTravelled": { "tiles": 2, "scope": "shown" } },
      "once": true
    },
    {
      "id": "aim",
      "teaches": "aim / facing",
      "level": "01-soft-open",
      "phase": "recording",
      "trigger": { "all": [ { "markDone": "move" }, { "inputNotUsedFor": { "input": "aim", "seconds": 3 } } ] },
      "skipIf": { "eventSeen": { "type": "kill", "tape": "live", "scope": "save" } },
      "anchor": "world:self",
      "text": "{btn:aim} turns you. You swing where you're facing.",
      "dismissOn": { "inputUsed": { "input": "aim", "scope": "shown" } },
      "once": true
    },
    {
      "id": "light",
      "teaches": "light attack",
      "level": "01-soft-open",
      "phase": "recording",
      "trigger": { "all": [ { "liveSelfNear": { "kind": "enemy", "tiles": 3.5 } }, { "inputNotUsedFor": { "input": "light", "seconds": 1.5 } } ] },
      "skipIf": { "eventSeen": { "type": "swing", "tape": "live", "detail": "light", "scope": "save" } },
      "anchor": "prompt:light",
      "text": "{btn:light} swings. Quick, cheap, plenty for the small ones.",
      "dismissOn": { "eventSeen": { "type": "swing", "tape": "live", "detail": "light", "scope": "shown" } },
      "once": true
    },
    {
      "id": "ruler-lane",
      "teaches": "reading the ruler: the playhead is now, the lane records what you do",
      "level": "01-soft-open",
      "phase": "recording",
      "trigger": { "all": [ { "markDone": "move" }, { "takeProgress": { "min": 0.25 } } ] },
      "anchor": "ruler.lane:active",
      "text": "The line is now. Swing, and watch your lane keep the receipt.",
      "dismissOn": { "eventSeen": { "type": "swing", "tape": "live", "scope": "shown" } },
      "once": true
    },

    {
      "id": "speed-fast",
      "teaches": "tape speed changes how the world moves (fast tape, slow world)",
      "level": "any",
      "phase": "recording",
      "trigger": { "all": [ { "activeSpeedIs": { "min": 2 } }, { "takeProgress": { "min": 0.04 } } ] },
      "anchor": "ruler.playhead",
      "text": "{speed} tape. You're quick, so the room crawls. The playhead agrees.",
      "dismissOn": { "shownFor": { "min": 6 } },
      "once": true
    },
    {
      "id": "speed-slow",
      "teaches": "tape speed changes how the world moves (slow tape, fast world)",
      "level": "any",
      "phase": "recording",
      "trigger": { "all": [ { "activeSpeedIs": { "max": 0.5 } }, { "takeProgress": { "min": 0.04 } } ] },
      "anchor": "ruler.playhead",
      "text": "{speed} tape. You're the slow one now; the room runs double.",
      "dismissOn": { "shownFor": { "min": 6 } },
      "once": true
    },
    {
      "id": "heavy",
      "teaches": "heavy attack",
      "level": "02-hit-harder",
      "phase": "recording",
      "trigger": { "all": [ { "liveSelfNear": { "kind": "breakable", "tiles": 3 } }, { "inputNotUsedFor": { "input": "heavy", "seconds": 1.5 } } ] },
      "skipIf": { "eventSeen": { "type": "swing", "tape": "live", "detail": "heavy", "scope": "save" } },
      "anchor": "prompt:heavy",
      "text": "{btn:heavy} is the heavy. Slow wind-up, hits like you mean it.",
      "dismissOn": { "eventSeen": { "type": "swing", "tape": "live", "detail": "heavy", "scope": "shown" } },
      "once": true
    },
    {
      "id": "previous-self",
      "teaches": "the first time a previous self appears",
      "level": "any",
      "phase": "recording",
      "trigger": { "all": [ { "tapesCommitted": { "min": 1 } }, { "selfIs": { "who": "previous", "state": "alive" } }, { "beat": { "min": 1 } } ] },
      "anchor": "world:self:subject",
      "text": "That's you, last take. She can't change. The room can.",
      "dismissOn": { "shownFor": { "min": 6 } },
      "once": true
    },
    {
      "id": "same-beat",
      "teaches": "two selves at one moment: line hits up on the ruler",
      "level": "04-second-opinion",
      "phase": "recording",
      "trigger": { "all": [ { "tapesCommitted": { "min": 1 } }, { "eventSeen": { "type": "clang", "tape": "live", "detail": "shield", "scope": "phase" } } ] },
      "anchor": "ruler",
      "text": "Her swings are notched on the ruler. Land yours on the same notch.",
      "dismissOn": { "eventSeen": { "type": "kill", "scope": "shown" } },
      "once": true
    },
    {
      "id": "knockback",
      "teaches": "knockback really moves enemies",
      "level": "06-crossfire",
      "phase": "recording",
      "trigger": { "eventSeen": { "type": "hit", "tape": "live", "target": "enemy", "scope": "phase" } },
      "anchor": "world:entity:subject",
      "text": "Hits shove. Wherever it lands, it carries on from there.",
      "dismissOn": { "shownFor": { "min": 5 } },
      "once": true
    },
    {
      "id": "interact",
      "teaches": "interact",
      "level": "any",
      "phase": "recording",
      "trigger": { "all": [ { "liveSelfNear": { "kind": "switch", "tiles": 1.5 } }, { "inputNotUsedFor": { "input": "interact", "seconds": 1.5 } } ] },
      "skipIf": { "eventSeen": { "type": "interact", "tape": "live", "scope": "save" } },
      "anchor": "prompt:interact",
      "text": "{btn:interact} flips the lever. It stays flipped until someone flips it back.",
      "dismissOn": { "eventSeen": { "type": "interact", "tape": "live", "scope": "shown" } },
      "once": true
    },
    {
      "id": "dodge",
      "teaches": "dodge",
      "level": "any",
      "phase": "recording",
      "trigger": { "all": [ { "levelsCleared": { "min": 1 } }, { "eventSeen": { "type": "enemyTelegraph", "scope": "phase" } }, { "liveSelfNear": { "kind": "enemy", "tiles": 2.5 } }, { "inputNotUsedFor": { "input": "dodge", "seconds": 1 } } ] },
      "skipIf": { "inputUsed": { "input": "dodge", "scope": "save", "count": { "min": 2 } } },
      "anchor": "prompt:dodge",
      "text": "{btn:dodge} slips a hit, if you're honest about the timing.",
      "dismissOn": { "inputUsed": { "input": "dodge", "scope": "shown" } },
      "once": true
    },
    {
      "id": "repeat-wrap",
      "teaches": "repeat: the loop point",
      "level": "any",
      "phase": ["recording", "review"],
      "trigger": { "eventSeen": { "type": "tapeWrap", "scope": "phase" } },
      "anchor": "world:self:subject",
      "text": "Loop point. She snaps back to her start and does it all again.",
      "dismissOn": { "shownFor": { "min": 5 } },
      "once": true
    },
    {
      "id": "reverse-turn",
      "teaches": "reverse: the turnaround re-fires events",
      "level": "any",
      "phase": ["recording", "review"],
      "trigger": { "eventSeen": { "type": "tapeTurn", "scope": "phase" } },
      "anchor": "world:self:subject",
      "text": "Turnaround. Backwards, each swing swings again and each lever flips back.",
      "dismissOn": { "shownFor": { "min": 5 } },
      "once": true
    },
    {
      "id": "trap-fair",
      "teaches": "traps hit everyone",
      "level": "any",
      "phase": ["recording", "review"],
      "trigger": { "eventSeen": { "type": "kill", "detailIn": ["spikes", "crusher", "flame", "dart"], "scope": "phase" } },
      "anchor": "world:event",
      "text": "Traps aren't picky. Enemies die in them too.",
      "dismissOn": { "shownFor": { "min": 5 } },
      "once": true
    },

    {
      "id": "review",
      "teaches": "review is the authoritative combined run",
      "level": "any",
      "phase": "review",
      "trigger": { "firstTimePhase": "review" },
      "anchor": "ruler",
      "text": "Playback. Every take so far, true speed. This run is the verdict.",
      "dismissOn": { "shownFor": { "min": 6 } },
      "once": true
    },
    {
      "id": "tape-end",
      "teaches": "a tape that runs out holds its last pose",
      "level": "any",
      "phase": "review",
      "trigger": { "eventSeen": { "type": "tapeEnd", "scope": "phase" } },
      "anchor": "ruler.lane:subject",
      "text": "Tape ran out early. That self holds her last pose and still counts.",
      "dismissOn": { "shownFor": { "min": 6 } },
      "once": true
    },
    {
      "id": "lanes",
      "teaches": "one ruler, one lane per take",
      "level": "any",
      "phase": "review",
      "trigger": { "all": [ { "tapesCommitted": { "min": 1 } }, { "markDone": "review" } ] },
      "anchor": "ruler",
      "text": "One ruler, every take. Line things up by beat, not by feel.",
      "dismissOn": { "shownFor": { "min": 6 } },
      "once": true
    },
    {
      "id": "review-skip",
      "teaches": "review can be skipped; a lost run can be ended",
      "level": "any",
      "phase": "review",
      "trigger": { "all": [ { "markDone": "review" }, { "markDone": "decide" }, { "phaseElapsed": { "min": 3 } } ] },
      "skipIf": { "sessionActionUsed": { "action": ["skip", "endAttempt"], "scope": "save" } },
      "anchor": "prompt:skip",
      "text": "Seen enough? {btn:skip} cuts to the decision.",
      "dismissOn": { "sessionActionUsed": { "action": ["skip", "endAttempt"], "scope": "shown" } },
      "once": true
    },

    {
      "id": "decide",
      "teaches": "retry versus commit; nothing is auto-committed",
      "level": "any",
      "phase": "decision",
      "trigger": { "firstTimePhase": "decision" },
      "anchor": "prompt:commit",
      "text": "{btn:commit} keeps the take. {btn:retryTake} bins it. Nothing's kept until you say.",
      "dismissOn": { "sessionActionUsed": { "action": ["commit", "retryTake", "resetAll"], "scope": "shown" } },
      "linger": 45,
      "once": true
    },
    {
      "id": "ghost-not-kept",
      "teaches": "a recording ghost's effects do not replay",
      "level": "any",
      "phase": "decision",
      "trigger": { "eventSeen": { "type": "selfDeath", "tape": "live", "scope": "take" } },
      "anchor": "deck:active",
      "text": "On replay she dies there again. What the ghost did after won't happen.",
      "dismissOn": { "sessionActionUsed": { "action": ["commit", "retryTake", "resetAll"], "scope": "shown" } },
      "linger": 45,
      "once": true
    },
    {
      "id": "desync-lane",
      "teaches": "reading a desync gap on the ruler",
      "level": "any",
      "phase": "decision",
      "trigger": { "all": [ { "markDone": "desync" }, { "eventSeen": { "type": "desync", "scope": "take" } } ] },
      "anchor": "ruler.lane:subject",
      "text": "The gap on her lane is the skip. Nothing she did in it counted.",
      "dismissOn": { "sessionActionUsed": { "action": ["commit", "retryTake", "resetAll"], "scope": "shown" } },
      "linger": 45,
      "once": true
    },
    {
      "id": "decide-reset",
      "teaches": "reset-all is the only way to change an older take, and it wipes everything",
      "level": "any",
      "phase": "decision",
      "trigger": { "all": [ { "tapesCommitted": { "min": 1 } }, { "retriesThisTake": { "min": 2 } }, { "outcomeIs": "fail" } ] },
      "skipIf": { "sessionActionUsed": { "action": "resetAll", "scope": "save" } },
      "anchor": "prompt:resetAll",
      "text": "Older take the problem? {btn:resetAll} wipes every cassette. All of them.",
      "dismissOn": { "sessionActionUsed": { "action": ["commit", "retryTake", "resetAll"], "scope": "shown" } },
      "linger": 45,
      "once": true
    },

    {
      "id": "speed-pick",
      "teaches": "choosing a tape speed",
      "level": "02-hit-harder",
      "phase": "setup",
      "trigger": { "all": [ { "speedsOffered": { "min": 2 } }, { "deckStatusIs": { "deck": "active", "status": "armed" } } ] },
      "skipIf": { "sessionActionUsed": { "action": ["speedUp", "speedDown"], "scope": "save" } },
      "anchor": "deck.speed",
      "text": "{btn:speedDown} {btn:speedUp} change tape speed. Per cassette, your call.",
      "dismissOn": { "sessionActionUsed": { "action": ["speedUp", "speedDown"], "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "speed-span",
      "teaches": "speed sets how much of the master ruler a take covers",
      "level": "any",
      "phase": "setup",
      "trigger": { "all": [ { "markDone": "speed-pick" }, { "sessionActionUsed": { "action": ["speedUp", "speedDown"], "scope": "phase" } } ] },
      "anchor": "ruler.lane:active",
      "text": "Speed sets how much ruler this take covers. Watch the lane stretch.",
      "dismissOn": { "sessionActionUsed": { "action": "record", "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "momentum-speed",
      "teaches": "tape speed multiplies momentum",
      "level": "any",
      "phase": "setup",
      "trigger": { "all": [ { "eventSeen": { "type": "clang", "detailPrefix": "needs ", "scope": "level" } }, { "not": { "eventSeen": { "type": "break", "scope": "level" } } }, { "speedsOffered": { "min": 2 } } ] },
      "anchor": "deck.speed",
      "text": "Tape speed multiplies every hit. Same swing, faster tape, more wallop.",
      "dismissOn": { "sessionActionUsed": { "action": ["speedUp", "record"], "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "overdub-setup",
      "teaches": "the first overdub: every take restarts at beat zero and kept takes replay",
      "level": "any",
      "phase": "setup",
      "trigger": { "all": [ { "tapesCommitted": { "min": 1 } }, { "deckStatusIs": { "deck": "active", "status": "armed" } } ] },
      "anchor": "deck:active",
      "text": "Next cassette. Every take starts at beat zero; the kept ones replay.",
      "dismissOn": { "sessionActionUsed": { "action": "record", "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "endmode-pick",
      "teaches": "choosing an end behaviour",
      "level": "any",
      "phase": "setup",
      "trigger": { "all": [ { "endModesOffered": { "min": 2 } }, { "deckStatusIs": { "deck": "active", "status": "armed" } } ] },
      "skipIf": { "sessionActionUsed": { "action": "cycleEndMode", "scope": "save" } },
      "anchor": "deck.endMode",
      "text": "{btn:cycleEndMode} picks what the tape does when it runs out early.",
      "dismissOn": { "sessionActionUsed": { "action": "cycleEndMode", "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "repeat",
      "teaches": "repeat",
      "level": "any",
      "phase": "setup",
      "trigger": { "activeEndModeIs": "repeat" },
      "anchor": "ruler.lane:active",
      "text": "Repeat: the take loops from its top until the room is done.",
      "dismissOn": { "sessionActionUsed": { "action": ["record", "cycleEndMode"], "scope": "shown" } },
      "linger": 30,
      "once": true
    },
    {
      "id": "reverse",
      "teaches": "reverse",
      "level": "any",
      "phase": "setup",
      "trigger": { "activeEndModeIs": "reverse" },
      "anchor": "ruler.lane:active",
      "text": "Reverse: at the end, the take runs backwards to where it began.",
      "dismissOn": { "sessionActionUsed": { "action": ["record", "cycleEndMode"], "scope": "shown" } },
      "linger": 30,
      "once": true
    },

    {
      "id": "cinematic",
      "teaches": "the cinematic is the winning run, locked",
      "level": "any",
      "phase": "cinematic",
      "trigger": { "all": [ { "firstTimePhase": "cinematic" }, { "phaseElapsed": { "min": 1 } } ] },
      "anchor": "ruler",
      "text": "It worked. Now watch it properly: every take, true speed, hands off.",
      "dismissOn": { "shownFor": { "min": 6 } },
      "once": true
    }
  ]
}
