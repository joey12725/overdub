{
  "name": "overdub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "OVERDUB - an isometric, music-linked puzzle-combat game about recording four versions of yourself onto cassette.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright": "1.49",
    "typescript": "5.6",
    "vite": "5.4",
    "vitest": "2.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
