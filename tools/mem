#!/usr/bin/env bash
# Prints the machine's memory use as a whole-number percentage. Agents call this before starting a
# heavy process (Blender, a Godot run, a big test suite) and wait while it is above 85.
#
# Do NOT poll this in a loop. On this machine every process that exits can leave a "zombie" process
# object behind (something keeps a reference to it), each holding roughly 64-110 KB that no task
# manager shows. A loop that calls this every few seconds starts several processes per call, so it
# makes the number it is waiting on go up. When the figure is high and the warning below appears,
# waiting cannot help: only a reboot (or closing whatever holds the references) frees the memory.
#
#   bash tools/mem          the percentage on stdout; a warning on stderr when zombies hold the memory
#   bash tools/mem --why    also prints live processes, process objects, and commit use on stderr
powershell -NoProfile -Command "
\$o = Get-CimInstance Win32_OperatingSystem
[math]::Round(100 * (1 - \$o.FreePhysicalMemory / \$o.TotalVisibleMemorySize))
try {
  \$objects = [int64](Get-Counter '\\Objects\\Processes' -ErrorAction Stop).CounterSamples[0].CookedValue
  \$live = (Get-Process).Count
  \$zombies = \$objects - \$live
  if ('$1' -eq '--why') {
    [Console]::Error.WriteLine(('[mem] live processes {0}, process objects {1}, commit {2} of {3} GB' -f \$live, \$objects, [math]::Round((\$o.TotalVirtualMemorySize - \$o.FreeVirtualMemory) / 1MB, 1), [math]::Round(\$o.TotalVirtualMemorySize / 1MB, 1)))
  }
  if (\$zombies -gt 20000) {
    [Console]::Error.WriteLine(('[mem] {0} exited processes are still held in memory (about {1} GB). Waiting will not lower this figure and polling raises it: reboot before running anything heavy.' -f \$zombies, [math]::Round(\$zombies * 64KB / 1GB, 1)))
  }
} catch {}
"
