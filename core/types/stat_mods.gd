class_name StatMods
extends RefCounted
## Numeric stat modifiers (types.ts StatMods). Every field is a MULTIPLIER applied on top of the base
## value (1 = unchanged) unless its name ends in `_add` (prototype `...Add`), in which case it is added.
## Modifiers from all equipped items combine (multipliers multiply, adds add).
##
## Representation: the prototype's optional keys become fields holding the identity value (1.0, or 0.0
## for adds), which is exactly what an absent key means. So a fresh StatMods.new() is the prototype's
## NEUTRAL_MODS, and ResolvedLoadout.mods (Required<StatMods>) is the same class. to_dict() omits
## identity-valued keys, like the catalogue does.

## Run speed (tiles per local second).
var move_speed: float = 1.0
## How quickly velocity approaches the input direction.
var accel: float = 1.0
## How much velocity survives a direction change / action (momentum retention).
var momentum_retention: float = 1.0
var dodge_distance: float = 1.0
## Length of the dodge invulnerability window.
var dodge_iframes: float = 1.0
## Recovery before another dodge is allowed.
var dodge_cooldown: float = 1.0
## Momentum generated by melee swings.
var melee_impact: float = 1.0
## Damage dealt per unit momentum.
var damage: float = 1.0
## Knockback distance per unit momentum.
var knockback: float = 1.0
## Maximum knockback distance.
var knockback_cap: float = 1.0
## Stagger duration per unit momentum.
var stagger: float = 1.0
## Extra momentum from moving into a strike.
var approach_bonus: float = 1.0
## Recovery spark travel speed (DESYNC-02).
var spark_speed: float = 1.0
## Reach for switches and other interactions, in tiles (added).
var interact_radius_add: float = 0.0
## Ranged weapon projectile speed.
var projectile_speed: float = 1.0
## Ranged weapon cooldown.
var ranged_cooldown: float = 1.0

## Prototype key (JSON) -> field name, in the prototype's declaration order.
const KEY_TO_FIELD: Dictionary[String, StringName] = {
	"moveSpeed": &"move_speed",
	"accel": &"accel",
	"momentumRetention": &"momentum_retention",
	"dodgeDistance": &"dodge_distance",
	"dodgeIframes": &"dodge_iframes",
	"dodgeCooldown": &"dodge_cooldown",
	"meleeImpact": &"melee_impact",
	"damage": &"damage",
	"knockback": &"knockback",
	"knockbackCap": &"knockback_cap",
	"stagger": &"stagger",
	"approachBonus": &"approach_bonus",
	"sparkSpeed": &"spark_speed",
	"interactRadiusAdd": &"interact_radius_add",
	"projectileSpeed": &"projectile_speed",
	"rangedCooldown": &"ranged_cooldown",
}


## Every prototype stat key, in declaration order (loadout.ts StatKey).
static func keys() -> Array[String]:
	var out: Array[String] = []
	out.assign(KEY_TO_FIELD.keys())
	return out


## True for keys that add (`...Add`) rather than multiply (loadout.ts isAdditiveStat).
static func is_additive(key: String) -> bool:
	return key.ends_with("Add")


## Identity value of a key: 0 for adds, 1 for multipliers.
static func identity_of(key: String) -> float:
	return 0.0 if is_additive(key) else 1.0


## Value by prototype key ("moveSpeed"). Unknown keys read as their identity.
func get_stat(key: String) -> float:
	var f: StringName = KEY_TO_FIELD.get(key, &"")
	return float(get(f)) if f != &"" else identity_of(key)


## Set by prototype key; unknown keys are ignored.
func set_stat(key: String, value: float) -> void:
	var f: StringName = KEY_TO_FIELD.get(key, &"")
	if f != &"":
		set(f, value)


func copy() -> StatMods:
	var o := StatMods.new()
	o.copy_from(self)
	return o


func copy_from(o: StatMods) -> void:
	move_speed = o.move_speed
	accel = o.accel
	momentum_retention = o.momentum_retention
	dodge_distance = o.dodge_distance
	dodge_iframes = o.dodge_iframes
	dodge_cooldown = o.dodge_cooldown
	melee_impact = o.melee_impact
	damage = o.damage
	knockback = o.knockback
	knockback_cap = o.knockback_cap
	stagger = o.stagger
	approach_bonus = o.approach_bonus
	spark_speed = o.spark_speed
	interact_radius_add = o.interact_radius_add
	projectile_speed = o.projectile_speed
	ranged_cooldown = o.ranged_cooldown


## Absent keys keep their identity value.
static func from_dict(d: Dictionary) -> StatMods:
	var m := StatMods.new()
	for key: String in KEY_TO_FIELD:
		if d.has(key):
			m.set_stat(key, ODJson.num(d, key, identity_of(key)))
	return m


## Keys whose value differs from identity (all keys when `full`), in declaration order.
func to_dict(full: bool = false) -> Dictionary:
	var out := {}
	for key: String in KEY_TO_FIELD:
		var v := get_stat(key)
		if full or v != identity_of(key):
			out[key] = v
	return out
