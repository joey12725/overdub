; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters
;
; OVERDUB: see docs/GODOT-PORT.md for what each non-default setting is for.

config_version=5

[application]

config/name="OVERDUB"
config/description="An isometric, music-linked puzzle-combat game about recording four versions of yourself onto cassette."
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icon.svg"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inference_on_variant=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
